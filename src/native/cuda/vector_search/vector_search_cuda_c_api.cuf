        real(c_float), intent(in) :: query_vector(dimension)
        real(c_float), intent(in) :: &
            database_vectors(dimension, vector_count)

        real(c_float), intent(out) :: topk_distances(k)
        integer(c_int64_t), intent(out) :: topk_indices(k)

        call l2_search_cuda( &
