program test_vector_search_cuda_core
    use, intrinsic :: iso_fortran_env, only: real32, int64

    use fnlp_vector_search_core, only: &
        l2_database_serial, ip_database_serial, &
        l2_search_serial, ip_search_serial

    use fnlp_vector_search_cuda_core, only: &
        l2_database_cuda, ip_database_cuda, &
        l2_search_cuda, ip_search_cuda, &
        l2_database_batch_cuda, ip_database_batch_cuda, &
        l2_search_batch_cuda, ip_search_batch_cuda

    implicit none

    call test_known_single_scores()
    call test_single_multiple_blocks()
    call test_single_dimension()
    call test_zero_and_negative_values()
    call test_empty_database()
    call test_single_search()
    call test_single_deterministic_ties()
    call test_batch_score_matrices()
    call test_batch_size_one()
    call test_batch_search()
    call test_batch_deterministic_ties()
    call test_multiple_batch_cuda_blocks()

    print *, "CUDA vector-search core tests passed"

contains

    subroutine test_known_single_scores()
        integer, parameter :: dimension = 3
        integer, parameter :: vector_count = 4
        real(real32) :: query(dimension)
        real(real32) :: database(dimension, vector_count)
        real(real32) :: cpu_l2(vector_count), cuda_l2(vector_count)
        real(real32) :: cpu_ip(vector_count), cuda_ip(vector_count)
        real(real32) :: expected_l2(vector_count)
        real(real32) :: expected_ip(vector_count)

        query = [1.0_real32, 2.0_real32, 3.0_real32]
        database(:, 1) = [1.0_real32, 2.0_real32, 3.0_real32]
        database(:, 2) = [2.0_real32, 0.0_real32, 4.0_real32]
        database(:, 3) = [-1.0_real32, -2.0_real32, -3.0_real32]
        database(:, 4) = 0.0_real32
        expected_l2 = [0.0_real32, 6.0_real32, 56.0_real32, 14.0_real32]
        expected_ip = [14.0_real32, 14.0_real32, -14.0_real32, 0.0_real32]

        call l2_database_serial(query, database, cpu_l2)
        call l2_database_cuda(query, database, cuda_l2)
        call ip_database_serial(query, database, cpu_ip)
        call ip_database_cuda(query, database, cuda_ip)

        call assert_real32_vector_close(cpu_l2, expected_l2, "known CPU L2")
        call assert_real32_vector_close(cuda_l2, expected_l2, "known CUDA L2")
        call assert_real32_vector_close(cpu_ip, expected_ip, "known CPU IP")
        call assert_real32_vector_close(cuda_ip, expected_ip, "known CUDA IP")
        print *, "Known vector scores: PASS"
    end subroutine test_known_single_scores


    subroutine test_single_multiple_blocks()
        integer, parameter :: dimension = 17
        integer, parameter :: vector_count = 600
        real(real32) :: query(dimension)
        real(real32) :: database(dimension, vector_count)
        real(real32) :: cpu_l2(vector_count), cuda_l2(vector_count)
        real(real32) :: cpu_ip(vector_count), cuda_ip(vector_count)
        integer :: d, v

        do d = 1, dimension
            query(d) = real(d - 9, real32) / 7.0_real32
        end do
        do v = 1, vector_count
            do d = 1, dimension
                database(d, v) = real(modulo(d * 13 + v * 7, 41) - 20, real32) / 9.0_real32
            end do
        end do

        call l2_database_serial(query, database, cpu_l2)
        call l2_database_cuda(query, database, cuda_l2)
        call ip_database_serial(query, database, cpu_ip)
        call ip_database_cuda(query, database, cuda_ip)
        call assert_real32_vector_close(cuda_l2, cpu_l2, "multi-block single L2")
        call assert_real32_vector_close(cuda_ip, cpu_ip, "multi-block single IP")
        print *, "Multiple CUDA blocks: PASS"
    end subroutine test_single_multiple_blocks


    subroutine test_single_dimension()
        real(real32) :: query(1), database(1, 5)
        real(real32) :: cuda_l2(5), cuda_ip(5)
        query = [2.0_real32]
        database(1, :) = [-2.0_real32, 0.0_real32, 2.0_real32, 3.0_real32, 5.0_real32]
        call l2_database_cuda(query, database, cuda_l2)
        call ip_database_cuda(query, database, cuda_ip)
        call assert_real32_vector_close(cuda_l2, &
            [16.0_real32, 4.0_real32, 0.0_real32, 1.0_real32, 9.0_real32], &
            "single-dimension L2")
        call assert_real32_vector_close(cuda_ip, &
            [-4.0_real32, 0.0_real32, 4.0_real32, 6.0_real32, 10.0_real32], &
            "single-dimension IP")
        print *, "Single-dimension vectors: PASS"
    end subroutine test_single_dimension


    subroutine test_zero_and_negative_values()
        real(real32) :: query(4), database(4, 3)
        real(real32) :: cpu_l2(3), cuda_l2(3), cpu_ip(3), cuda_ip(3)
        query = [0.0_real32, -2.5_real32, 4.0_real32, -1.0_real32]
        database(:, 1) = 0.0_real32
        database(:, 2) = [-3.0_real32, 2.0_real32, -4.0_real32, 1.0_real32]
        database(:, 3) = query
        call l2_database_serial(query, database, cpu_l2)
        call l2_database_cuda(query, database, cuda_l2)
        call ip_database_serial(query, database, cpu_ip)
        call ip_database_cuda(query, database, cuda_ip)
        call assert_real32_vector_close(cuda_l2, cpu_l2, "zero-negative L2")
        call assert_real32_vector_close(cuda_ip, cpu_ip, "zero-negative IP")
        print *, "Zero and negative values: PASS"
    end subroutine test_zero_and_negative_values


    subroutine test_empty_database()
        real(real32) :: query(3)
        real(real32), allocatable :: database(:, :), cuda_l2(:), cuda_ip(:)
        query = [1.0_real32, 2.0_real32, 3.0_real32]
        allocate(database(3, 0), cuda_l2(0), cuda_ip(0))
        call l2_database_cuda(query, database, cuda_l2)
        call ip_database_cuda(query, database, cuda_ip)
        if (size(cuda_l2) /= 0 .or. size(cuda_ip) /= 0) &
            error stop "Empty output must have size zero"
        deallocate(database, cuda_l2, cuda_ip)
        print *, "Empty database: PASS"
    end subroutine test_empty_database


    subroutine test_single_search()
        integer, parameter :: k = 3
        real(real32) :: query(3), database(3, 5)
        real(real32) :: cpu_l2(k), cuda_l2(k), cpu_ip(k), cuda_ip(k)
        integer(int64) :: cpu_l2_i(k), cuda_l2_i(k), cpu_ip_i(k), cuda_ip_i(k)
        query = [1.0_real32, 2.0_real32, 3.0_real32]
        database(:, 1) = query
        database(:, 2) = [2.0_real32, 2.0_real32, 3.0_real32]
        database(:, 3) = [1.0_real32, 4.0_real32, 3.0_real32]
        database(:, 4) = 0.0_real32
        database(:, 5) = [-1.0_real32, -2.0_real32, -3.0_real32]
        call l2_search_serial(query, database, k, cpu_l2, cpu_l2_i)
        call l2_search_cuda(query, database, k, cuda_l2, cuda_l2_i)
        call ip_search_serial(query, database, k, cpu_ip, cpu_ip_i)
        call ip_search_cuda(query, database, k, cuda_ip, cuda_ip_i)
        call assert_real32_vector_close(cuda_l2, cpu_l2, "single L2 top-k")
        call assert_int64_vector_equal(cuda_l2_i, cpu_l2_i, "single L2 indices")
        call assert_real32_vector_close(cuda_ip, cpu_ip, "single IP top-k")
        call assert_int64_vector_equal(cuda_ip_i, cpu_ip_i, "single IP indices")
        print *, "CUDA single search with CPU top-k: PASS"
    end subroutine test_single_search


    subroutine test_single_deterministic_ties()
        integer, parameter :: k = 4
        real(real32) :: query(2), database(2, 4), l2(k), ip(k)
        integer(int64) :: l2_i(k), ip_i(k), expected(k)
        query = [1.0_real32, 1.0_real32]
        database(:, 1) = [1.0_real32, 0.0_real32]
        database(:, 2) = [0.0_real32, 1.0_real32]
        database(:, 3) = database(:, 1)
        database(:, 4) = database(:, 2)
        expected = [0_int64, 1_int64, 2_int64, 3_int64]
        call l2_search_cuda(query, database, k, l2, l2_i)
        call ip_search_cuda(query, database, k, ip, ip_i)
        call assert_int64_vector_equal(l2_i, expected, "single L2 ties")
        call assert_int64_vector_equal(ip_i, expected, "single IP ties")
        print *, "Deterministic CPU top-k ties: PASS"
    end subroutine test_single_deterministic_ties


    subroutine test_batch_score_matrices()
        integer, parameter :: dimension = 3, query_count = 3, vector_count = 4
        real(real32) :: queries(dimension, query_count)
        real(real32) :: database(dimension, vector_count)
        real(real32) :: cpu_l2(vector_count, query_count), cuda_l2(vector_count, query_count)
        real(real32) :: cpu_ip(vector_count, query_count), cuda_ip(vector_count, query_count)
        integer :: q
        queries(:, 1) = [1.0_real32, 2.0_real32, 3.0_real32]
        queries(:, 2) = [-1.0_real32, 0.5_real32, 2.0_real32]
        queries(:, 3) = [0.0_real32, -2.0_real32, 1.0_real32]
        database(:, 1) = [1.0_real32, 2.0_real32, 3.0_real32]
        database(:, 2) = [2.0_real32, 0.0_real32, 4.0_real32]
        database(:, 3) = [-1.0_real32, -2.0_real32, -3.0_real32]
        database(:, 4) = 0.0_real32
        do q = 1, query_count
            call l2_database_serial(queries(:, q), database, cpu_l2(:, q))
            call ip_database_serial(queries(:, q), database, cpu_ip(:, q))
        end do
        call l2_database_batch_cuda(queries, database, cuda_l2)
        call ip_database_batch_cuda(queries, database, cuda_ip)
        call assert_real32_matrix_close(cuda_l2, cpu_l2, "batch L2 matrix")
        call assert_real32_matrix_close(cuda_ip, cpu_ip, "batch IP matrix")
        print *, "Batched CUDA score matrices: PASS"
    end subroutine test_batch_score_matrices


    subroutine test_batch_size_one()
        real(real32) :: queries(4, 1), database(4, 5)
        real(real32) :: single_l2(5), batch_l2(5, 1), single_ip(5), batch_ip(5, 1)
        integer :: d, v
        queries(:, 1) = [1.0_real32, -2.0_real32, 3.0_real32, 0.5_real32]
        do v = 1, 5
            do d = 1, 4
                database(d, v) = real(d - 2 * v, real32) / 3.0_real32
            end do
        end do
        call l2_database_cuda(queries(:, 1), database, single_l2)
        call l2_database_batch_cuda(queries, database, batch_l2)
        call ip_database_cuda(queries(:, 1), database, single_ip)
        call ip_database_batch_cuda(queries, database, batch_ip)
        call assert_real32_vector_close(batch_l2(:, 1), single_l2, "batch-one L2")
        call assert_real32_vector_close(batch_ip(:, 1), single_ip, "batch-one IP")
        print *, "Batch size one: PASS"
    end subroutine test_batch_size_one


    subroutine test_batch_search()
        integer, parameter :: dimension = 3, query_count = 3, vector_count = 5, k = 3
        real(real32) :: queries(dimension, query_count), database(dimension, vector_count)
        real(real32) :: cpu_l2(k, query_count), cuda_l2(k, query_count)
        real(real32) :: cpu_ip(k, query_count), cuda_ip(k, query_count)
        integer(int64) :: cpu_l2_i(k, query_count), cuda_l2_i(k, query_count)
        integer(int64) :: cpu_ip_i(k, query_count), cuda_ip_i(k, query_count)
        integer :: q
        queries(:, 1) = [1.0_real32, 2.0_real32, 3.0_real32]
        queries(:, 2) = [2.0_real32, -1.0_real32, 0.5_real32]
        queries(:, 3) = [-2.0_real32, 1.0_real32, 4.0_real32]
        database(:, 1) = queries(:, 1)
        database(:, 2) = [2.0_real32, 2.0_real32, 3.0_real32]
        database(:, 3) = [1.0_real32, 4.0_real32, 3.0_real32]
        database(:, 4) = 0.0_real32
        database(:, 5) = [-1.0_real32, -2.0_real32, -3.0_real32]
        do q = 1, query_count
            call l2_search_serial(queries(:, q), database, k, cpu_l2(:, q), cpu_l2_i(:, q))
            call ip_search_serial(queries(:, q), database, k, cpu_ip(:, q), cpu_ip_i(:, q))
        end do
        call l2_search_batch_cuda(queries, database, k, cuda_l2, cuda_l2_i)
        call ip_search_batch_cuda(queries, database, k, cuda_ip, cuda_ip_i)
        call assert_real32_matrix_close(cuda_l2, cpu_l2, "batch L2 top-k")
        call assert_int64_matrix_equal(cuda_l2_i, cpu_l2_i, "batch L2 indices")
        call assert_real32_matrix_close(cuda_ip, cpu_ip, "batch IP top-k")
        call assert_int64_matrix_equal(cuda_ip_i, cpu_ip_i, "batch IP indices")
        print *, "Batched CUDA search with CPU top-k: PASS"
    end subroutine test_batch_search


    subroutine test_batch_deterministic_ties()
        integer, parameter :: k = 4
        real(real32) :: queries(2, 2), database(2, 4), l2(k, 2), ip(k, 2)
        integer(int64) :: l2_i(k, 2), ip_i(k, 2), expected(k, 2)
        queries(:, 1) = [1.0_real32, 1.0_real32]
        queries(:, 2) = [-1.0_real32, -1.0_real32]
        database(:, 1) = [1.0_real32, 0.0_real32]
        database(:, 2) = [0.0_real32, 1.0_real32]
        database(:, 3) = database(:, 1)
        database(:, 4) = database(:, 2)
        expected(:, 1) = [0_int64, 1_int64, 2_int64, 3_int64]
        expected(:, 2) = expected(:, 1)
        call l2_search_batch_cuda(queries, database, k, l2, l2_i)
        call ip_search_batch_cuda(queries, database, k, ip, ip_i)
        call assert_int64_matrix_equal(l2_i, expected, "batch L2 ties")
        call assert_int64_matrix_equal(ip_i, expected, "batch IP ties")
        print *, "Batched deterministic ties: PASS"
    end subroutine test_batch_deterministic_ties


    subroutine test_multiple_batch_cuda_blocks()
        integer, parameter :: dimension = 11, query_count = 5, vector_count = 173
        real(real32) :: queries(dimension, query_count), database(dimension, vector_count)
        real(real32) :: cpu_l2(vector_count, query_count), cuda_l2(vector_count, query_count)
        real(real32) :: cpu_ip(vector_count, query_count), cuda_ip(vector_count, query_count)
        integer :: d, q, v
        do q = 1, query_count
            do d = 1, dimension
                queries(d, q) = real(modulo(d * 7 + q * 11, 37) - 18, real32) / 8.0_real32
            end do
        end do
        do v = 1, vector_count
            do d = 1, dimension
                database(d, v) = real(modulo(d * 13 + v * 5, 43) - 21, real32) / 9.0_real32
            end do
        end do
        do q = 1, query_count
            call l2_database_serial(queries(:, q), database, cpu_l2(:, q))
            call ip_database_serial(queries(:, q), database, cpu_ip(:, q))
        end do
        call l2_database_batch_cuda(queries, database, cuda_l2)
        call ip_database_batch_cuda(queries, database, cuda_ip)
        call assert_real32_matrix_close(cuda_l2, cpu_l2, "multi-block batch L2")
        call assert_real32_matrix_close(cuda_ip, cpu_ip, "multi-block batch IP")
        print *, "Multiple batched CUDA blocks: PASS"
    end subroutine test_multiple_batch_cuda_blocks


    subroutine assert_real32_vector_close(actual, expected, label)
        real(real32), intent(in) :: actual(:), expected(:)
        character(len=*), intent(in) :: label
        real(real32), parameter :: atol = 1.0e-5_real32, rtol = 1.0e-5_real32
        real(real32) :: difference, allowed
        integer :: i
        if (size(actual) /= size(expected)) error stop "real32 vector size mismatch"
        do i = 1, size(actual)
            difference = abs(actual(i) - expected(i))
            allowed = atol + rtol * abs(expected(i))
            if (difference > allowed) then
                print *, trim(label), " mismatch at ", i
                print *, "Actual/expected/error/allowed:", actual(i), expected(i), difference, allowed
                error stop "real32 vector assertion failed"
            end if
        end do
    end subroutine assert_real32_vector_close


    subroutine assert_int64_vector_equal(actual, expected, label)
        integer(int64), intent(in) :: actual(:), expected(:)
        character(len=*), intent(in) :: label
        if (size(actual) /= size(expected)) error stop "int64 vector size mismatch"
        if (any(actual /= expected)) then
            print *, trim(label), " mismatch"
            print *, "Actual:  ", actual
            print *, "Expected:", expected
            error stop "int64 vector assertion failed"
        end if
    end subroutine assert_int64_vector_equal


    subroutine assert_real32_matrix_close(actual, expected, label)
        real(real32), intent(in) :: actual(:, :), expected(:, :)
        character(len=*), intent(in) :: label
        integer :: column_index
        if (any(shape(actual) /= shape(expected))) error stop "real32 matrix shape mismatch"
        do column_index = 1, size(actual, dim=2)
            call assert_real32_vector_close(actual(:, column_index), &
                expected(:, column_index), label)
        end do
    end subroutine assert_real32_matrix_close


    subroutine assert_int64_matrix_equal(actual, expected, label)
        integer(int64), intent(in) :: actual(:, :), expected(:, :)
        character(len=*), intent(in) :: label
        if (any(shape(actual) /= shape(expected))) error stop "int64 matrix shape mismatch"
        if (any(actual /= expected)) then
            print *, trim(label), " mismatch"
            print *, "Actual:  ", actual
            print *, "Expected:", expected
            error stop "int64 matrix assertion failed"
        end if
    end subroutine assert_int64_matrix_equal

end program test_vector_search_cuda_core
